{
  "name": "platform-agnostic-typescript-template",
  "version": "1.0.0",
  "description": "Platform Agnostic TypeScript Template (PATT)",
  "keywords": [
    "react",
    "webpack",
    "typescript",
    "sass",
    "starter",
    "boilerplate"
  ],
  "author": "Andrew Naish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naishtech/platform-agnostic-typescript-template"
  },
  "bugs": {
    "url": "https://github.com/naishtech/platform-agnostic-typescript-template/issues"
  },
  "homepage": "https://www..io",
  "scripts": {
    "build:prod": "npm run clean-dist && webpack --config webpack/prod.js",
    "build:test": "npm run clean-dist && webpack --config webpack/test.js",
    "build:dev": "npm run clean-dist && webpack --config webpack/dev.js",
    "clean-dist": "rimraf dist",
    "lint:es": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:sass": "stylelint \"src/**/*.scss\"",
    "lint": "npm run lint:es && npm run lint:sass",
    "start": "npm run start:web",
    "start:web": "webpack serve --config webpack/dev.js",
    "start:desktop": "npm run build:dev && node npxcap.js electron",
    "start:android": "npm run build:dev && node npxcap.js android",
    "start:ios": "npm run build:dev && npx cap copy ios && node npxcap.js ios",
    "switch:test": "firebase use test",
    "deploy:test": "npm run clean-dist && npm run switch:test && npm run build:test && firebase deploy --only hosting",
    "switch:prod": "firebase use prod",
    "deploy:prod": "npm run clean-dist && npm run switch:prod && npm run build:prod && firebase deploy --only hosting",
    "test": "jest --coverage --config jest/jest.json --runInBand"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/jest": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "copy-webpack-plugin": "latest",
    "css-loader": "latest",
    "eslint": "latest",
    "eslint-plugin-react": "latest",
    "firebase-tools": "latest",
    "html-webpack-plugin": "latest",
    "jest": "latest",
    "jest-environment-jsdom": "latest",
    "rimraf": "latest",
    "sass": "latest",
    "sass-loader": "latest",
    "source-map-loader": "latest",
    "style-loader": "latest",
    "stylelint": "latest",
    "stylelint-config-standard-scss": "latest",
    "ts-jest": "latest",
    "ts-loader": "latest",
    "typescript": "latest",
    "webpack": "latest",
    "webpack-cli": "latest",
    "webpack-dev-server": "latest",
    "webpack-merge": "latest"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/core": "latest",
    "@capacitor/ios": "latest",
    "firebase": "latest",
    "html-react-parser": "latest",
    "mobx": "latest",
    "mobx-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-ga4": "latest",
    "react-router-dom": "latest"
  }
}
